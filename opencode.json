{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/muse-spark-1.2-contributor",
  "small_model": "opencode-go/deepseek-v4-flash",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  },
  "watcher": {
    "ignore": [
      "target/**",
      "node_modules/**",
      ".git/**",
      "dist/**",
      "packaging/deb/**"
    ]
  },
  "permission": "allow",
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    ".jspace/WORKSPACE.md"
  ],
  "agent": {
    "plan": {
      "description": "Planificador barato: arch, budgets, DAG",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.1,
      "permission": "allow"
    },
    "build": {
      "description": "Constructor principal Rust",
      "mode": "primary",
      "model": "opencode-go/muse-spark-1.2-contributor",
      "temperature": 0.2,
      "permission": "allow"
    },
    "cerebro-audit": {
      "description": "Auditor cerebro puro Rust: core/geometry/command sin egui/wgpu, invariants type-safety",
      "mode": "subagent",
      "model": "opencode-go/muse-spark-1.2-contributor",
      "temperature": 0.1,
      "permission": "allow"
    },
    "piel-ui": {
      "description": "Especialista egui/wgpu Piel: render &Estado sin I/O, tokens, performance",
      "mode": "subagent",
      "model": "opencode-go/muse-spark-1.2-contributor",
      "temperature": 0.2
    },
    "perf-profiler": {
      "description": "Profiler Rust: puffin, rayon, wgpu, lyon, spade. Mide antes de optimizar",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "temperature": 0.15
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "setCacheKey": true
      }
    }
  }
}
